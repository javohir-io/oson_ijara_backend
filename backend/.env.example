# Copy this file to .env and adjust as needed.
DATABASE_URL=postgresql+psycopg2://oson:oson_secret@db:5432/oson_ijara
SECRET_KEY=please-change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=uploads
BASE_URL=http://localhost:8000

# Optional — Cloudflare R2 object storage for uploads. Leave all four blank
# to keep using local disk storage (fine for local dev / docker-compose).
# Needed on hosts with no persistent disk (e.g. Render's free tier) so
# uploaded photos survive a restart.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
